generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum TenantDomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM_DOMAIN
}

enum TenantDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  STAFF
  MEMBER
}

enum ProvisioningJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  status                 TenantStatus            @default(ACTIVE)
  primaryDomain          String?
  projectType            String
  shortDescription       String?
  longDescription        String?
  city                   String?
  state                  String?
  country                String?
  phone                  String?
  whatsapp               String?
  email                  String?
  website                String?
  currency               String                  @default("MXN")
  timezone               String                  @default("America/Mexico_City")
  logoUrl                String?
  heroImageUrl           String?
  primaryColor           String                  @default("#e11d48")
  secondaryColor         String                  @default("#111827")
  socialLinksJson        String                  @default("{}")
  featureFlagsJson       String                  @default("{}")
  legalName              String?
  legalRfc               String?
  contractLegalText      String?
  stripeAccountId        String?
  stripeChargesEnabled   Boolean                 @default(false)
  stripeDetailsSubmitted Boolean                 @default(false)
  revenueShareRate       Float                   @default(0.1)
  domains                TenantDomain[]
  users                  User[]
  servicePackages        ServicePackage[]
  integrationSettings    IntegrationSettings?
  bankSettings           BankSettings?
  messageTemplates       MessageTemplate[]
  provisioningJobs       TenantProvisioningJob[]
  payments               Payment[]
  musicians              Musician[]
  clientProfiles         ClientProfile[]
  locations              Location[]
  bookingRequests        BookingRequest[]
  events                 Event[]
  notifications          Notification[]
  inboxItems             InboxItem[]
  contracts              Contract[]
  songs                  Song[]
  setlists               Setlist[]
  providers              Provider[]
  reviews                Review[]
  rehearsals             Rehearsal[]
  bandEvents             BandEvent[]
  siteMedia              SiteMedia[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model TenantDomain {
  id                String             @id @default(uuid())
  tenantId          String
  hostname          String             @unique
  type              TenantDomainType
  status            TenantDomainStatus @default(PENDING)
  verificationToken String
  verifiedAt        DateTime?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

model InstallationState {
  id          String    @id @default("singleton")
  tenantId    String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id        String    @id @default(uuid())
  tenantId  String?
  name      String?
  email     String    @unique
  password  String
  role      UserRole  @default(TENANT_ADMIN)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Musician {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  role            String?
  instruments     String           @default("[]")
  bio             String?
  email           String?
  whatsapp        String?
  photoUrl        String?
  active          Boolean          @default(true)
  isTitular       Boolean          @default(true)
  titularId       String?
  titular         Musician?        @relation("Substitutes", fields: [titularId], references: [id], onDelete: SetNull)
  substitutes     Musician[]       @relation("Substitutes")
  eventMusicians  EventMusician[]
  rehearsalAttendance RehearsalAttendance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([titularId])
}

model ClientProfile {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  whatsapp        String?
  company         String?
  rfc             String?
  notes           String?
  city            String?
  state           String?
  bookingRequests BookingRequest[]
  events          Event[]
  inboxItems      InboxItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, email])
}

model Location {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  references      String?
  spaceType       String?
  logisticsNotes  String?
  city            String?
  state           String?
  mapsLink        String?
  phone           String?
  active          Boolean  @default(true)
  events          Event[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model BookingRequest {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortCode       String         @unique
  clientId        String?
  client          ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientWhatsapp  String?
  packageId       String?
  packageName     String?
  guestCount      Int?
  venueType       String?
  street          String?
  houseNumber     String?
  colonia         String?
  zipCode         String?
  address         String?
  city            String?
  state           String?
  mapsLink        String?
  isOutsideZone   Boolean        @default(false)
  viaticosAmount  Int            @default(0)
  requestedDate   DateTime?
  startTime       String?
  endTime         String?
  baseAmount      Int            @default(0)
  depositAmount   Int            @default(0)
  paymentMethod   String?
  status          String         @default("pending")
  paymentStatus   String         @default("pending")
  adminNote       String?
  source          String         @default("manual")
  eventId         String?        @unique
  event           Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  notifications   Notification[]
  inboxItems      InboxItem[]
  contract        Contract?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
}

model Event {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          ClientProfile?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  packageId       String?
  packageName     String?
  date            DateTime
  startTime       String?
  endTime         String?
  amount          Int              @default(0)
  deposit         Int              @default(0)
  balance         Int              @default(0)
  depositMethod   String?
  paymentMethod   String?
  paymentRef      String?
  status          String           @default("scheduled")
  notes           String?
  bookingRequest  BookingRequest?
  musicians       EventMusician[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

model EventMusician {
  id          String   @id @default(uuid())
  tenantId    String
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musicianId  String
  musician    Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([eventId, musicianId])
  @@index([tenantId])
  @@index([musicianId])
}

model Notification {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String
  channel           String          @default("whatsapp")
  recipient         String
  templateKey       String?
  message           String
  status            String          @default("pending")
  externalMessageId String?
  errorDetails      String?
  retries           Int             @default(0)
  lastRetryAt       DateTime?
  bookingRequestId  String?
  bookingRequest    BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([bookingRequestId])
}

model Song {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  artist        String?
  genre         String?
  language      String?
  era           String?
  durationMin   Int?
  songKey       String?
  notes         String?
  active        Boolean        @default(true)
  setlistSongs  SetlistSong[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, active])
}

model Setlist {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean       @default(true)
  songs       SetlistSong[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, active])
}

model SetlistSong {
  id         String   @id @default(uuid())
  tenantId   String
  setlistId  String
  setlist    Setlist  @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([setlistId, songId])
  @@index([tenantId])
  @@index([setlistId, position])
}

model Provider {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  contactName String?
  email       String?
  phone       String?
  whatsapp    String?
  city        String?
  baseRate    Int?
  currency    String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, category])
}

model Review {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientName String
  eventTitle String?
  eventDate  DateTime?
  rating     Int       @default(5)
  quote      String
  avatarUrl  String?
  source     String    @default("manual")
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, published])
}

model Rehearsal {
  id          String                @id @default(uuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  startTime   String?
  endTime     String?
  locationName String?
  address     String?
  mapsLink    String?
  goal        String?
  notes       String?
  status      String                @default("scheduled")
  attendance  RehearsalAttendance[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

model RehearsalAttendance {
  id           String    @id @default(uuid())
  tenantId     String
  rehearsalId  String
  rehearsal    Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  musicianId   String
  musician     Musician  @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  status       String    @default("invited")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([rehearsalId, musicianId])
  @@index([tenantId])
  @@index([musicianId])
}

model SiteMedia {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind          String   @default("gallery")
  title         String?
  alt           String
  url           String
  thumbnailUrl  String?
  caption       String?
  linkUrl       String?
  sortOrder     Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, kind, published, sortOrder])
}

model BandEvent {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  kind         String   @default("show")
  date         DateTime
  endDate      DateTime?
  startTime    String?
  endTime      String?
  venueName    String?
  city         String?
  country      String?
  ticketUrl    String?
  publicNotes  String?
  internalNotes String?
  published    Boolean  @default(false)
  status       String   @default("scheduled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, published])
  @@index([tenantId, status])
}

model Contract {
  id                    String         @id @default(uuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingRequestId      String         @unique
  bookingRequest        BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  shortToken            String         @unique
  legalSnapshot         String         // contract body with variables already substituted
  status                String         @default("draft") // draft | signed_admin | signed_client | signed_both | void
  adminSignerName       String?
  adminSignedAt         DateTime?
  clientSignerName      String?
  clientSignatureDataUrl String?       // reserved for canvas signature in 3e-2
  clientSignedAt        DateTime?
  voidedAt              DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model InboxItem {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber       String
  senderName        String?
  message           String
  type              String          @default("incoming")
  category          String?
  status            String          @default("pending")
  priority          String          @default("medium")
  rawPayloadJson    String?
  assignedToUserId  String?
  clientId          String?
  client            ClientProfile?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  bookingRequestId  String?
  bookingRequest    BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  receivedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
}

model Payment {
  id                      String    @id @default(uuid())
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripePaymentIntentId   String    @unique
  stripeCheckoutSessionId String?
  status                  String
  amount                  Int
  currency                String
  customerEmail           String?
  customerName            String?
  description             String?
  metadataJson            String    @default("{}")
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([tenantId])
}

model ServicePackage {
  id           String   @id @default(uuid())
  tenantId     String?
  name         String
  description  String?
  basePrice    Float    @default(0)
  minDuration  Int      @default(1)
  includesJson String   @default("[]")
  active       Boolean  @default(true)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model IntegrationSettings {
  id                       String   @id @default(uuid())
  tenantId                 String?  @unique
  stripeEnabled            Boolean  @default(false)
  stripePublishableKeyHint String?
  stripeSecretKey          String?
  stripeWebhookSecret      String?
  evolutionEnabled         Boolean  @default(false)
  evolutionBaseUrl         String?
  evolutionInstance        String?
  evolutionApiKey          String?
  googleCalendarEnabled    Boolean  @default(false)
  googleCalendarId         String?
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model BankSettings {
  id          String   @id @default(uuid())
  tenantId    String?  @unique
  bankName    String?
  account     String?
  clabe       String?
  beneficiary String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String?
  key       String
  label     String
  content   String
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantTemplate {
  id                    String                  @id @default(uuid())
  key                   String                  @unique
  name                  String
  description           String?
  defaultProjectType    String
  defaultPrimaryColor   String                  @default("#e11d48")
  defaultSecondaryColor String                  @default("#111827")
  defaultFeaturesJson   String                  @default("{}")
  active                Boolean                 @default(true)
  packages              TenantTemplatePackage[]
  messages              TenantTemplateMessage[]
  provisioningJobs      TenantProvisioningJob[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model TenantTemplatePackage {
  id           String         @id @default(uuid())
  templateId   String
  name         String
  description  String?
  basePrice    Float          @default(0)
  minDuration  Int            @default(1)
  includesJson String         @default("[]")
  template     TenantTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([templateId])
}

model TenantTemplateMessage {
  id         String         @id @default(uuid())
  templateId String
  key        String
  label      String
  content    String
  template   TenantTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([templateId, key])
  @@index([templateId])
}

model TenantProvisioningJob {
  id          String                @id @default(uuid())
  tenantId    String?
  templateId  String?
  status      ProvisioningJobStatus @default(PENDING)
  summary     String?
  error       String?
  inputJson   String                @default("{}")
  startedAt   DateTime?
  completedAt DateTime?
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  template    TenantTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([tenantId])
  @@index([templateId])
}
