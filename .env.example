# Postgres connection. For local dev with docker-compose use: postgresql://prob:prob@db:5432/prob_db?schema=public
DATABASE_URL=postgresql://prob:CHANGEME@localhost:5432/prob_db?schema=public

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public URL where the platform lives. For multi-tenant subdomains this is the base domain.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Optional integrations (filled by the wizard or per-tenant)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
